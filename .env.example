# ==============================================================================
# Firebase Web App 설정 (Vercel 배포 또는 로컬 .env.local 용도)
# Vercel 배포 시에는 Vercel 프로젝트 대시보드 -> Settings -> Environment Variables 에 등록하세요.
# ==============================================================================
VITE_FIREBASE_API_KEY="AIzaSyD-xxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_AUTH_DOMAIN="my-guestbook-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-guestbook-app"
VITE_FIREBASE_STORAGE_BUCKET="my-guestbook-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ==============================================================================
# AI Studio 기본 환경변수
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
